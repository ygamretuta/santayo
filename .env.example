# Server-side only. Enable "Places API (New)" for this key in Google Cloud.
# Without it the app runs on clearly-labelled demo data.
GOOGLE_MAPS_API_KEY=

# --- Admin dashboard (/admin) ---------------------------------------------
# Required to enable the dashboard at all. Generate with:
#   openssl rand -base64 30 | tr -d '/+=\n'     (password)
#   openssl rand -hex 32                          (session secret, 32+ chars)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: Google-reported quota + key rotation. See README -> Admin dashboard.
# Service account key file, raw JSON or base64-encoded:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Defaults to the project_id inside the key file:
GCP_PROJECT_ID=

# Optional: key rotation (writes the new key to Vercel and redeploys)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_HOOK_URL=

